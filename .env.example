# Copy to server/.env and fill in real values. Never commit server/.env itself.

DATABASE_URL=postgresql://securebox:securebox_dev_pw@localhost:5432/securebox

# Fill in once you have an AWS S3 bucket + IAM user (Phase 2)
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY=your-iam-access-key
S3_SECRET_KEY=your-iam-secret-key
S3_REGION=us-east-1

# Generate real secrets for anything beyond local dev:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=dev-access-secret-change-in-prod-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
COOKIE_SECRET=dev-cookie-secret-change-in-prod-min-32-chars

PORT=3001
NODE_ENV=development
